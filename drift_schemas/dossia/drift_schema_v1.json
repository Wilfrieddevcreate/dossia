    {
      "name": "document_types",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"document_types\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"category\" TEXT NOT NULL, \"description\" TEXT NULL, \"expiry_applicable\" INTEGER NOT NULL DEFAULT 0 CHECK (\"expiry_applicable\" IN (0, 1)), \"is_custom\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_custom\" IN (0, 1)), \"created_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "personal_documents",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"personal_documents\" (\"id\" TEXT NOT NULL, \"type_id\" TEXT NOT NULL REFERENCES document_types (id) ON DELETE RESTRICT, \"custom_name\" TEXT NULL, \"issue_date\" TEXT NULL, \"expiry_date\" TEXT NULL, \"issuer\" TEXT NULL, \"notes\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"archived_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "document_files",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"document_files\" (\"id\" TEXT NOT NULL, \"document_id\" TEXT NOT NULL REFERENCES personal_documents (id) ON DELETE CASCADE, \"file_name\" TEXT NOT NULL, \"relative_path\" TEXT NOT NULL, \"mime_type\" TEXT NULL, \"size_bytes\" INTEGER NOT NULL, \"created_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "dossiers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"dossiers\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"category\" TEXT NULL, \"description\" TEXT NULL, \"notes\" TEXT NULL, \"deadline\" TEXT NULL, \"status\" TEXT NOT NULL DEFAULT 'inProgress', \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"archived_at\" TEXT NULL, \"last_opened_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "required_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"required_items\" (\"id\" TEXT NOT NULL, \"dossier_id\" TEXT NOT NULL REFERENCES dossiers (id) ON DELETE CASCADE, \"type_id\" TEXT NULL REFERENCES document_types (id) ON DELETE RESTRICT, \"custom_name\" TEXT NULL, \"is_mandatory\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_mandatory\" IN (0, 1)), \"quantity\" INTEGER NOT NULL DEFAULT 1 CHECK(\"quantity\" >= 1), \"instructions\" TEXT NULL, \"status\" TEXT NOT NULL DEFAULT 'auto', \"notes\" TEXT NULL, \"position\" INTEGER NOT NULL, \"due_date\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"), CHECK (type_id IS NOT NULL OR custom_name IS NOT NULL));"
        }
      ]
    },
    {
      "name": "item_document_links",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"item_document_links\" (\"id\" TEXT NOT NULL, \"required_item_id\" TEXT NOT NULL REFERENCES required_items (id) ON DELETE CASCADE, \"personal_document_id\" TEXT NOT NULL REFERENCES personal_documents (id) ON DELETE RESTRICT, \"quantity_assigned\" INTEGER NOT NULL DEFAULT 1 CHECK(\"quantity_assigned\" >= 1), \"linked_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"required_item_id\", \"personal_document_id\"));"
        }
      ]
    },
    {
      "name": "tasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tasks\" (\"id\" TEXT NOT NULL, \"dossier_id\" TEXT NOT NULL REFERENCES dossiers (id) ON DELETE CASCADE, \"title\" TEXT NOT NULL, \"due_date\" TEXT NULL, \"is_completed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_completed\" IN (0, 1)), \"notes\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
