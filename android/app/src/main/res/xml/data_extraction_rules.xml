<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : aucune donnée de Dossia n'est copiée vers le cloud ni
     transférée vers un autre appareil par le système. Les sauvegardes se
     font uniquement depuis l'application (Réglages > Sauvegarde). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
